# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: gemini (recommended, free & fast) | ollama (local offline) | openai | anthropic
LLM_PROVIDER=gemini

# Google Gemini (Get your free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional: comma-separated fallback models if primary model is unavailable (503/429)
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Ollama (100% offline local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── NCBI / PubMed ─────────────────────────────────────────────────────────────
# Optional — raises rate limit from 3 to 10 req/s
# Register free at: https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local FastEmbed BAAI/bge-small-en-v1.5 model; cached automatically on first use.

# ── Vector DB (Phase 2) ───────────────────────────────────────────────────────
CHROMA_PATH=../data/chroma
