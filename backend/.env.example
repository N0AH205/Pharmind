# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama

# Ollama (local Qwen) — default
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (Phase 3 optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (Phase 3 optional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Phase 3 optional)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# ── NCBI / PubMed ─────────────────────────────────────────────────────────────
# Optional — raises rate limit from 3 to 10 req/s
# Register free at: https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local FastEmbed BAAI/bge-small-en-v1.5 model; cached automatically on first use.

# ── Vector DB (Phase 2) ───────────────────────────────────────────────────────
CHROMA_PATH=../data/chroma
